# Public values only. Never copy AUTH0_CLIENT_SECRET or AUTH0_SECRET here.
# Optional override; the app defaults to the deployed Fly.io API.
EXPO_PUBLIC_API_URL=https://nourish-api.fly.dev
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your-native-application-client-id
EXPO_PUBLIC_AUTH0_AUDIENCE=https://nourish-api
# Optional public Segment source write key. Unset/blank disables native analytics.
EXPO_PUBLIC_SEGMENT_WRITE_KEY=
