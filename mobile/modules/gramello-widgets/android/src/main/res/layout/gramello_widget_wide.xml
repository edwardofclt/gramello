<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/gramello_widget_background">
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GRAMELLO" android:textSize="10sp" android:textColor="#6ee7c7" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="16dp"><TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open app" android:textSize="30sp" android:textColor="#f4f8fb" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="30sp"/>
<TextView android:id="@+id/widget_goal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to open your diary" android:textSize="11sp" android:textColor="#8ca1b2" android:maxLines="1" android:ellipsize="end" />
<ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="7dp" android:layout_marginBottom="4dp" android:progressTint="#6ee7c7" android:progressBackgroundTint="#213b4d" android:max="100" android:progress="0" />
<TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:textColor="#8ca1b2" android:maxLines="1" android:ellipsize="end" /></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/widget_macros" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#f4f8fb" android:lineSpacingExtra="6dp" android:maxLines="3" />
<TextView android:id="@+id/widget_water" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:textColor="#78a9ff" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="6dp"/></LinearLayout></LinearLayout>
<TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gramello" android:textSize="9sp" android:textColor="#8ca1b2" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
