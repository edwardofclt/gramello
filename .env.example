# Copy to .env.local. These are server-only values; never use NEXT_PUBLIC_.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=
# API identifier configured in Auth0 for native access tokens.
AUTH0_AUDIENCE=https://your-gramello-api
# Client ID of the Auth0 Native application (public; never add a client secret).
AUTH0_MOBILE_CLIENT_ID=your-native-client-id
# Generate with: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:5173
