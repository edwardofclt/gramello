# Copy to .env.local. Server runtime origin for same-origin browser writes.
APP_BASE_URL=http://localhost:5173

# Server-only FoodData Central key (use wrangler secret put USDA_API_KEY in production).
USDA_API_KEY=
# OFF hosted search is disabled unless this is 1 and migration 0006 is applied.
# D1 enforces one request per 7 seconds across this deployment's workers.
OFF_SEARCH_ENABLED=0
